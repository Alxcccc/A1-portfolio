---
const { title = 'Alec Echavarría — Software Engineer' } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Alec Echavarría is a software engineer focused on backend systems, full-stack web development, and careful digital experiences." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg-primary: 237 237 233;
        --text-primary: 5 5 5;
        --bg-secondary: 237 237 233;
        --text-secondary: 5 5 5;
        --accent: 173 40 49;
        --overlay: 0 0 0;
        --surface: 255 255 255;
        --selection-bg: 173 40 49;
        --selection-text: 255 255 255;
        --ease-editorial: cubic-bezier(0.22, 1, 0.36, 1);
        --halo: 178 178 172;
      }
      [data-theme="dark"] {
        --bg-primary: 5 5 5;
        --text-primary: 255 255 255;
        --bg-secondary: 5 5 5;
        --text-secondary: 255 255 255;
        --accent: 173 40 49;
        --overlay: 255 255 255;
        --surface: 5 5 5;
        --selection-bg: 173 40 49;
        --selection-text: 255 255 255;
        --halo: 178 178 172;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background-color: rgb(var(--halo)); scroll-behavior: smooth; }
      body {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-weight: 400;
        color: rgb(var(--text-primary));
        background-color: rgb(var(--halo));
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.3s, color 0.3s;
        overflow-x: hidden;
      }
      ::selection { background: rgb(var(--selection-bg)); color: rgb(var(--selection-text)); }
      img { max-width: 100%; display: block; }
      h1, h2, h3 { text-wrap: balance; overflow-wrap: break-word; }
      a, button { -webkit-tap-highlight-color: transparent; }
      a { color: inherit; text-decoration: none; }
      section[id] { scroll-margin-top: 1.5rem; }
      a:focus-visible, button:focus-visible { outline: 1px solid rgb(var(--accent)); outline-offset: 4px; }

      .rounded-hairline {
        display: block;
        height: 2px;
        border: 0;
        border-radius: 9999px;
        background: rgb(var(--text-primary) / 0.3);
      }
      .rounded-border { position: relative; }
      .rounded-border::before,
      .rounded-border-end::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: 2px;
        border-radius: 9999px;
        background: rgb(var(--overlay) / 0.12);
        transition: background-color 0.5s var(--ease-editorial);
      }
      .rounded-border::before { top: 0; }
      .rounded-border-end::after { bottom: 0; }
      .skip-link {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 10000;
        padding: 0.65rem 0.8rem;
        color: rgb(var(--text-primary));
        background: rgb(var(--bg-primary));
        border: 1px solid rgb(var(--text-primary) / 0.2);
        transform: translateY(-200%);
        transition: transform 0.3s var(--ease-editorial), border-color 0.3s var(--ease-editorial);
      }
      .skip-link:focus { transform: translateY(0); }
      .skip-link:hover { border-color: rgb(var(--accent)); }
      .theme-toggle {
        cursor: pointer;
        color: rgb(var(--text-primary));
        background: rgb(var(--bg-primary) / 0.88);
        box-shadow: none;
        transition: background-color 0.3s, color 0.3s, border-color 0.3s;
      }
      .theme-toggle:hover {
        color: rgb(var(--accent));
        border-color: rgb(var(--accent));
      }
      .theme-toggle .sun { display: none; }
      .theme-toggle .moon { display: block; }
      [data-theme="dark"] .theme-toggle .sun { display: block; }
      [data-theme="dark"] .theme-toggle .moon { display: none; }

      #custom-cursor {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        width: 1.5rem;
        height: 1.5rem;
        border: 1px solid rgb(var(--text-primary) / 0.28);
        border-radius: 50%;
        pointer-events: none;
        transform: translate(-50%, -50%);
        transition: width 0.4s var(--ease-editorial),
                    height 0.4s var(--ease-editorial),
                    background-color 0.4s var(--ease-editorial),
                    border-color 0.4s var(--ease-editorial),
                    opacity 0.3s var(--ease-editorial);
        opacity: 0;
        mix-blend-mode: difference;
      }
      #custom-cursor.is-visible { opacity: 1; }
      #custom-cursor.is-hovering {
        width: 2.75rem;
        height: 2.75rem;
        background: rgb(237 237 233 / 0.06);
        border-color: rgb(237 237 233 / 0.7);
      }
      [data-theme="dark"] #custom-cursor {
        border-color: rgb(255 255 255 / 0.35);
        mix-blend-mode: difference;
      }
      @media (pointer: coarse) {
        #custom-cursor { display: none; }
      }

      .eyebrow,
      .section-kicker {
        color: rgb(var(--text-primary) / 0.5);
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        line-height: 1.4;
        text-transform: uppercase;
      }
      .section-kicker {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .section-kicker::before {
        width: 1.6rem;
        height: 1px;
        background: rgb(var(--accent));
        content: '';
      }
      .section-kicker-dark { color: rgb(var(--text-secondary) / 0.45); }
      .editorial-inline-link {
        position: relative;
        display: inline-block;
        transition: color 0.45s var(--ease-editorial);
      }
      .editorial-inline-link::after {
        position: absolute;
        right: 0;
        bottom: -0.25rem;
        left: 0;
        height: 1px;
        background: currentColor;
        content: '';
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.55s var(--ease-editorial);
      }
      .editorial-inline-link:hover { color: rgb(var(--accent)); }
      .editorial-inline-link:hover::after,
      .editorial-inline-link:focus-visible::after {
        transform: scaleX(1);
        transform-origin: left;
      }
      .editorial-tile {
        display: flex;
        min-height: 4.5rem;
        align-items: flex-end;
        justify-content: space-between;
        padding: 0.65rem 0.9rem;
        border-radius: 0.375rem 0.375rem 1.5rem 0.375rem;
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        transition: transform 0.5s var(--ease-editorial),
                    background-color 0.5s var(--ease-editorial),
                    color 0.5s var(--ease-editorial);
      }
      @media (min-width: 768px) {
        .editorial-tile {
          min-height: 6rem;
          padding: 0.75rem 1rem;
          font-size: 1.05rem;
        }
      }
      .editorial-tile:hover,
      .editorial-tile:focus-visible {
        transform: translateY(-2px);
      }

      .editorial-tile--about    { background-color: #f5e6d3; color: rgb(5 5 5); }
      .editorial-tile--projects { background-color: #e63312; color: #ffffff; }
      .editorial-tile--contact  { background-color: #f5a623; color: rgb(5 5 5); }

      .editorial-tile--about:hover,
      .editorial-tile--about:focus-visible,
      .editorial-tile--contact:hover,
      .editorial-tile--contact:focus-visible { color: rgb(5 5 5); }
      .editorial-tile--projects:hover,
      .editorial-tile--projects:focus-visible { color: #ffffff; }

      .editorial-tile-index {
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        opacity: 0.55;
        transition: opacity 0.5s var(--ease-editorial);
      }
      .editorial-tile--about .editorial-tile-index,
      .editorial-tile--contact .editorial-tile-index { color: rgb(5 5 5); }
      .editorial-tile--projects .editorial-tile-index { color: #ffffff; }
      .editorial-tile:hover .editorial-tile-index,
      .editorial-tile:focus-visible .editorial-tile-index { opacity: 0.9; }

      .about-record-label,
      .about-record-period {
        color: rgb(var(--text-primary) / 0.38);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
      }
      .about-details dt {
        margin-bottom: 0.35rem;
        color: rgb(var(--text-primary) / 0.38);
        font-size: 0.65rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .about-details dd {
        color: rgb(var(--text-primary) / 0.78);
        font-size: 0.82rem;
        line-height: 1.5;
      }
      .about-record {
        display: grid;
        grid-template-columns: 5.8rem minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: baseline;
        padding: 0.75rem 0;
        font-size: 0.875rem;
      }
      .about-record.rounded-border::before,
      .about-record.rounded-border-end::after { background: rgb(var(--overlay) / 0.1); }
      .about-record-period { text-align: right; }
      .page-band { position: relative; }
      .page-band-secondary::before,
      .page-band-dark::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        border-radius: 9999px;
        background: rgb(var(--overlay) / 0.14);
      }
      .page-band-dark {
        background-color: rgb(30 30 28);
        color: rgb(237 237 233);
      }
      .page-band-dark::before { background: rgb(255 255 255 / 0.1); }
      [data-theme="dark"] .page-band-dark {
        background-color: rgb(18 18 17);
      }
      .page-band-dark .section-kicker { color: rgb(255 255 255 / 0.55); }
      .page-band-dark .eyebrow { color: rgb(255 255 255 / 0.55); }
      .page-band-dark .contact-body { color: rgb(255 255 255 / 0.7); }
      .page-band-dark .contact-row {
        color: rgb(255 255 255 / 0.9);
      }
      .page-band-dark .contact-row.rounded-border::before,
      .page-band-dark .contact-row.rounded-border-end::after {
        background: rgb(255 255 255 / 0.16);
      }
      .page-band-dark .contact-row-handle { color: rgb(255 255 255 / 0.5); }
      .page-band-dark .contact-arrow { color: rgb(255 255 255 / 0.28); }
      .page-band-dark footer { color: rgb(255 255 255 / 0.42); }
      .project-feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.78fr);
        gap: clamp(2.5rem, 8vw, 8rem);
        padding: 2.5rem 0 4rem;
      }
      .project-feature.rounded-border::before,
      .project-feature.rounded-border-end::after { background: rgb(var(--text-secondary) / 0.18); }
      .project-feature-copy { min-width: 0; }
      .project-feature-meta,
      .project-row-index,
      .project-row-focus,
      .project-row-year,
      .project-plate-label {
        color: rgb(var(--text-secondary) / 0.42);
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        line-height: 1.4;
        text-transform: uppercase;
      }
      .project-feature-meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }
      .project-feature-title {
        margin-top: clamp(3rem, 8vw, 7rem);
        color: rgb(var(--text-secondary) / 0.94);
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.8rem, 7vw, 6.5rem);
        font-weight: 300;
        letter-spacing: -0.04em;
        line-height: 0.9;
        transition: color 0.5s var(--ease-editorial);
      }
      .project-feature:hover .project-feature-title,
      .project-feature:focus-within .project-feature-title { color: rgb(var(--accent)); }
      .project-feature-descriptor {
        margin-top: 1rem;
        color: rgb(var(--text-secondary) / 0.55);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .project-feature-description {
        max-width: 34rem;
        margin-top: 1.75rem;
        color: rgb(var(--text-secondary) / 0.68);
        font-size: 0.95rem;
        line-height: 1.7;
      }
      .project-feature-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        max-width: 34rem;
        margin-top: 2.5rem;
        padding-top: 1rem;
      }
      .project-feature-details.rounded-border::before { background: rgb(var(--text-secondary) / 0.14); }
      .project-feature-details dt {
        margin-bottom: 0.4rem;
        color: rgb(var(--text-secondary) / 0.38);
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .project-feature-details dd {
        color: rgb(var(--text-secondary) / 0.76);
        font-size: 0.78rem;
        line-height: 1.5;
      }
      .project-action {
        margin-top: 2.5rem;
        color: rgb(var(--text-secondary) / 0.78);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .project-plate {
        position: relative;
        display: flex;
        min-height: 20rem;
        flex-direction: column;
        justify-content: space-between;
        align-self: stretch;
        padding: 1rem 0 1rem 1.25rem;
      }
      .project-plate::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 2px;
        border-radius: 9999px;
        background: rgb(var(--text-secondary) / 0.18);
      }
      .project-flow { margin-top: auto; }
      .project-flow-step {
        position: relative;
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        gap: 0.75rem;
        align-items: center;
        min-height: 3.5rem;
      }
      .project-flow-step.rounded-border::before { background: rgb(var(--text-secondary) / 0.18); }
      .project-flow-step.rounded-border-end::after {
        display: block;
        background: rgb(var(--text-secondary) / 0.18);
      }
      .project-flow-step::after {
        position: absolute;
        bottom: -0.75rem;
        left: 1.05rem;
        color: rgb(var(--text-secondary) / 0.35);
        content: '↓';
        font-size: 0.75rem;
      }
      .project-flow-step:last-child::after { display: none; }
      .project-flow-step span {
        color: rgb(var(--text-secondary) / 0.35);
        font-size: 0.62rem;
        letter-spacing: 0.1em;
      }
      .project-flow-step strong {
        color: rgb(var(--text-secondary) / 0.82);
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .project-index { margin-top: 3.5rem; display: grid; gap: 1.25rem; }
      .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 11rem;
        padding: 1.25rem 1.4rem 1.1rem;
        border-radius: 0.375rem 0.375rem 0.375rem 1.5rem;
        background: rgb(var(--overlay) / 0.025);
        border: 1px solid rgb(var(--overlay) / 0.07);
        color: rgb(var(--text-secondary));
        transition: background-color 0.5s var(--ease-editorial),
                    border-color 0.5s var(--ease-editorial),
                    transform 0.5s var(--ease-editorial),
                    color 0.5s var(--ease-editorial);
      }
      .project-card:hover,
      .project-card:focus-visible {
        background: rgb(var(--accent) / 0.05);
        border-color: rgb(var(--accent) / 0.28);
        transform: translateY(-2px);
        color: rgb(var(--text-secondary));
      }
      .project-card-index {
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        color: rgb(var(--text-secondary) / 0.35);
        transition: color 0.5s var(--ease-editorial);
      }
      .project-card:hover .project-card-index,
      .project-card:focus-visible .project-card-index { color: rgb(var(--accent)); }
      .project-card-title {
        margin-top: 0.65rem;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1.65rem, 2.5vw, 2.4rem);
        font-weight: 300;
        letter-spacing: -0.02em;
        line-height: 0.95;
        color: rgb(var(--text-secondary));
        transition: color 0.5s var(--ease-editorial);
      }
      .project-card:hover .project-card-title,
      .project-card:focus-visible .project-card-title { color: rgb(var(--accent)); }
      .project-card-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
      }
      .project-card-meta {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgb(var(--text-secondary) / 0.55);
      }
      .project-card-tags {
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        color: rgb(var(--text-secondary) / 0.32);
      }
      .project-card-year {
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        color: rgb(var(--text-secondary) / 0.4);
        text-transform: uppercase;
      }
      .project-card .project-arrow {
        margin-left: 0.5rem;
        color: rgb(var(--text-secondary) / 0.3);
        transition: color 0.5s var(--ease-editorial), transform 0.5s var(--ease-editorial);
      }
      .project-card:hover .project-arrow,
      .project-card:focus-visible .project-arrow {
        color: rgb(var(--accent));
        transform: translate(0.2rem, -0.2rem);
      }
      @media (max-width: 767px) {
        .project-card { min-height: 9rem; padding: 1rem 1.1rem 0.9rem; }
        .project-card-title { font-size: 1.5rem; }
        .project-card-footer { flex-wrap: wrap; }
      }
      .project-arrow,
      .contact-arrow {
        display: inline-block;
        margin-left: 0.35rem;
        color: rgb(var(--text-secondary) / 0.25);
        transform: translate(0, 0);
        transition: color 0.5s var(--ease-editorial), transform 0.5s var(--ease-editorial);
      }
      .project-card:hover .project-arrow,
      .project-card:focus-within .project-arrow,
      .project-feature:hover .project-arrow,
      .project-feature:focus-within .project-arrow,
      .contact-row:hover .contact-arrow,
      .contact-row:focus-visible .contact-arrow {
        color: rgb(var(--accent));
        transform: translate(0.2rem, -0.2rem);
      }
      .contact-index { max-width: 52rem; }
      .contact-row {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: baseline;
        padding: 1.15rem 0;
        color: rgb(var(--text-secondary) / 0.84);
        transition: color 0.5s var(--ease-editorial), border-color 0.5s var(--ease-editorial), padding 0.5s var(--ease-editorial);
      }
      .contact-row.rounded-border::before,
      .contact-row.rounded-border-end::after { background: rgb(var(--text-secondary) / 0.16); }
      .contact-row:hover.rounded-border::before,
      .contact-row:hover.rounded-border-end::after,
      .contact-row:focus-visible.rounded-border::before,
      .contact-row:focus-visible.rounded-border-end::after { background: rgb(var(--accent)); }
      .contact-row:hover,
      .contact-row:focus-visible {
        padding-inline: 0.5rem;
        color: rgb(var(--accent));
      }
      .contact-row-name { font-size: 1rem; font-weight: 500; }
      .contact-row-handle {
        color: rgb(var(--text-secondary) / 0.48);
        font-size: 0.78rem;
        transition: color 0.5s var(--ease-editorial);
      }
      .contact-row:hover .contact-row-handle,
      .contact-row:focus-visible .contact-row-handle { color: currentColor; }

      html.motion-ready [data-reveal],
      html.motion-ready .reveal {
        opacity: 0;
        translate: 0 1rem;
        transition: opacity 0.9s var(--ease-editorial), translate 0.9s var(--ease-editorial);
        transition-delay: var(--reveal-delay, 0ms);
      }
      html.motion-ready [data-reveal].is-visible,
      html.motion-ready .reveal.is-visible {
        opacity: 1;
        translate: 0 0;
      }

      @media (max-width: 767px) {
        .project-feature { grid-template-columns: 1fr; gap: 3rem; }
        .project-feature-title { margin-top: 3.5rem; }
        .project-plate { min-height: 15rem; padding-left: 0; }
        .project-plate::before { top: 0; bottom: auto; left: 0; right: 0; width: auto; height: 2px; }
        .contact-row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.4rem 1rem; }
        .contact-row-handle { grid-column: 1; }
        .contact-row .contact-arrow { grid-column: 2; grid-row: 1 / span 2; }
      }
      @media (max-width: 640px) {
        .about-record {
          grid-template-columns: 1fr auto;
          gap: 0.35rem 0.75rem;
        }
        .about-record-label { grid-column: 1 / -1; }
        .about-record-period { grid-column: 2; grid-row: 2; }
      }
      @media (max-width: 480px) {
        .project-feature-details { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <div id="custom-cursor" aria-hidden="true"></div>
    <slot />
    <script>
      (function() {
        const STORAGE_KEY = 'theme';
        const html = document.documentElement;

        function getPreferredTheme() {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored) return stored;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function setTheme(theme) {
          if (theme === 'dark') {
            html.dataset.theme = 'dark';
          } else {
            delete html.dataset.theme;
          }
          localStorage.setItem(STORAGE_KEY, theme);
          const toggle = document.querySelector('.theme-toggle');
          toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
          toggle?.setAttribute('title', theme === 'dark' ? 'Use light theme' : 'Use dark theme');
        }

        setTheme(getPreferredTheme());

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const revealItems = document.querySelectorAll('[data-reveal], .reveal');
        html.classList.add('motion-ready');
        if (prefersReducedMotion.matches || !('IntersectionObserver' in window)) {
          revealItems.forEach((item) => item.classList.add('is-visible'));
        } else {
          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealItems.forEach((item) => revealObserver.observe(item));
        }

        // Expose toggle function globally
        window.toggleTheme = function() {
          const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
          setTheme(next);
        };

        const cursor = document.getElementById('custom-cursor');
        const isCoarse = window.matchMedia('(pointer: coarse)').matches;
        if (cursor && !isCoarse && !prefersReducedMotion.matches) {
          let cursorX = 0, cursorY = 0, activeX = 0, activeY = 0;
          let rafId = null;

          function cursorTick() {
            activeX += (cursorX - activeX) * 0.18;
            activeY += (cursorY - activeY) * 0.18;
            cursor.style.transform = `translate(${activeX}px, ${activeY}px) translate(-50%, -50%)`;
            rafId = requestAnimationFrame(cursorTick);
          }

          document.addEventListener('pointermove', (event) => {
            cursorX = event.clientX;
            cursorY = event.clientY;
            if (!cursor.classList.contains('is-visible')) {
              cursor.classList.add('is-visible');
            }
            if (!rafId) rafId = requestAnimationFrame(cursorTick);
          }, { passive: true });

          document.addEventListener('mouseleave', () => {
            cursor.classList.remove('is-visible');
            if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
          });

          const hoverSelector = 'a, button, [role="button"], .editorial-tile, .project-card, .contact-row';
          document.querySelectorAll(hoverSelector).forEach((el) => {
            el.addEventListener('mouseenter', () => cursor.classList.add('is-hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('is-hovering'));
          });
        }
      })();
    </script>
  </body>
</html>
